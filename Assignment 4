
4a)Write a c program to perform basic operations such as addition of two matrices 
Code: 
#include <stdio.h> 
int main() { 
 int rows, cols; 
  
 printf("Enter the number of rows: "); 
 scanf("%d", &rows); 
 printf("Enter the number of columns: "); 
 scanf("%d", &cols); 
 int mat1[rows][cols], mat2[rows][cols], result[rows][cols]; 
  
 printf("\nEnter elements of the first matrix:\n");  for (int i = 0; i < rows; i++) { 
 for (int j = 0; j < cols; j++) { // Fixed loop condition (j < cols) 
 printf("Element [%d][%d]: ", i, j); // Removed stray single quote 
 scanf("%d", &mat1[i][j]);
 } 
 } 
  
 printf("\nEnter elements of the second matrix:\n");  for (int i = 0; i < rows; i++) { 
 for (int j = 0; j < cols; j++) { 
 printf("Element [%d][%d]: ", i, j);  scanf("%d", &mat2[i][j]); 
 } 
 } 
  
 for (int i = 0; i < rows; i++) { 
 for (int j = 0; j < cols; j++) { 
 result[i][j] = mat1[i][j] + mat2[i][j];  } 
 } 
 // 5. Output Result 
 printf("\nResultant matrix after addition:\n");  for (int i = 0; i < rows; i++) { 
 for (int j = 0; j < cols; j++) { 
 printf("%d\t", result[i][j]); 
 } 
 printf("\n"); 
 }

 return 0; 
} 


